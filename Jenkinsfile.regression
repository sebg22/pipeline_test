pipeline {
    agent any

    stages {
        stage('Run downstream jobs') {
            steps {
                script {
                    def jobs = [
                        'lab-unit-tests',
                        'lab-api-tests',
                        'lab-dependency-report',
                        'lab-publish-report'
                    ]

                    def branches = [:]

                    jobs.each { jobName ->
                        branches[jobName] = {
				def start = System.currentTimeMillis()

                            build job: jobName, wait: true


				def seconds = (System.currentTimeMillis() - start) / 1000
				echo "${jobName} took ${seconds} seconds"
                        }
                    }

                    parallel branches
                }
            }
        }
    }
}
